# =====================================================================
#  VARIABLES DE ENTORNO - YOREN STUDIOS LANDING
# =====================================================================
# Copia este archivo como ".env.local" si necesitas cambiarlas.
# Todas son OPCIONALES: la web funciona sin configurar nada.
# =====================================================================

# Si esta vacia, el formulario de contacto usa la API integrada de
# Next.js (ruta /api/contact) y todo corre con "npm run dev".
#
# Si defines una URL, el formulario envia los mensajes al backend
# Express independiente (carpeta /server):
#   NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=

# Puerto del backend Express (carpeta /server).
PORT=4000

# Correo de contacto que se muestra en la web.
NEXT_PUBLIC_CONTACT_EMAIL=hola@yorenstudios.com

# Enlace de invitacion al Discord de Yoren Studios.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/yorenstudios

# =====================================================================
#  PLANTILLA (para clonar la web por cliente)
# =====================================================================
# Tema de colores. Opciones:
#   violeta, azul, indigo, esmeralda, naranja, rosa, rojo,
#   grafito (negro/gris plata), acero (negro/gris metal)
# (podes crear los tuyos en src/lib/theme.ts)
NEXT_PUBLIC_THEME=violeta

# Nombre del cliente/empresa (sale en la web y en el titulo).
NEXT_PUBLIC_SITE_NAME=Yoren Studios
NEXT_PUBLIC_SITE_SHORT=Yoren

# =====================================================================
#  FORMULARIO: ENVIO DE EMAIL (Resend)   https://resend.com
# =====================================================================
# Si defines RESEND_API_KEY, cada mensaje te llega por correo.
RESEND_API_KEY=
# Remitente (debe estar verificado en Resend).
RESEND_FROM_EMAIL=Yoren Studios <onboarding@resend.dev>
# A que correo llegan los avisos.
CONTACT_TO_EMAIL=hola@yorenstudios.com

# =====================================================================
#  FORMULARIO: BASE DE DATOS (Supabase)   https://supabase.com
# =====================================================================
# Si defines las dos primeras, cada mensaje se guarda en la tabla.
# La service_role key es SECRETA: solo aca, nunca en el navegador.
# Ejecuta supabase/schema.sql en el SQL Editor para crear la tabla.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=contact_messages
